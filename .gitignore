.python-version

# pipenv
#   According to pypa/pipenv#598, it is recommended to checkin Pipfile.lock into version control.
#   However, a locked dependency might be different for each platform & a dependency of
#   a dependency could cross platform. Therefore, it's sometimes better to ignore it.
# pipenv.lock

# Poetry
#   Similar to pipenv.lock, it's generally recommended to include poetry.lock in version control.
#   This is a sensible default for most projects.
# poetry.lock

# pdm
#   Similar to poetry.lock, it's generally recommended to include pdm.lock in version control
#   pdm.lock
.pdm.toml

# PEP 582; used by e.g. PDM
